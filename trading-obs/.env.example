# Copy to .env and fill in. .env is git-ignored: never commit it.

# ── Database ──────────────────────────────────────────────────────────────
# Supabase: Project Settings -> Database -> Connection string.
#   Workers (long-lived): session pooler, port 5432
#   API (many short queries): transaction pooler, port 6543 also works
# Always keep sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local research without a server:
# DATABASE_URL=sqlite:///kerno.db
# Local docker Postgres (docker compose --profile localdb up):
# POSTGRES_PASSWORD=<long random string>
# DATABASE_URL=postgresql://kerno:<same password>@db:5432/kerno

# ── Ingestion ─────────────────────────────────────────────────────────────
KERNO_STREAMS=binance:BTCUSDT,ETHUSDT;bybit:BTCUSDT;okx:BTC-USDT
KERNO_STORE_RAW=0

# ── Evaluation ────────────────────────────────────────────────────────────
# Round-trip cost charged to every signal, bps (fees both legs + half-spread both legs).
KERNO_COST_BPS=10
KERNO_ENTRY_DELAY_MS=250

# ── API ───────────────────────────────────────────────────────────────────
KERNO_CORS_ORIGINS=
KERNO_RATE_LIMIT_PER_MIN=120
KERNO_EXPOSE_DOCS=1
# Trust X-Forwarded-* only from your reverse proxy / platform load balancer
FORWARDED_ALLOW_IPS=127.0.0.1
# KERNO_AUTH_DISABLED=1   # local development only, never on a public host

# ── Archive (Parquet). Local dir, plus optional S3-compatible upload ──────
KERNO_ARCHIVE_DIR=archive
# Supabase Storage S3: Storage -> Settings -> S3 connection
# KERNO_S3_BUCKET=kerno-archive
# KERNO_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# KERNO_S3_REGION=<region>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

LOG_LEVEL=INFO
